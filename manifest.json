{
  "manifest_version": 3,
  "name": "Zoziologie Web Tools",
  "version": "5.9.0",
  "description": "CSV exports and shortcuts for eBird, Macaulay Library, and Biolovision (ornitho, faune-france).",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "background": {
    "service_worker": "js/background.js",
    "scripts": [
      "js/background.js"
    ]
  },
  "action": {
    "default_title": "Zoziologie Web Tools",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "logo/logo_16.png",
      "32": "logo/logo_32.png",
      "48": "logo/logo_48.png",
      "128": "logo/logo_128.png"
    }
  },
  "icons": {
    "16": "logo/logo_16.png",
    "32": "logo/logo_32.png",
    "48": "logo/logo_48.png",
    "128": "logo/logo_128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.faune-france.org/*",
        "*://www.faune-aura.org/*",
        "*://www.faune-bfc.org/*",
        "*://www.faune-bretagne.org/*",
        "*://www.faune-charente.org/*",
        "*://www.faune-cher.org/*",
        "*://www.faune-deux-sevres.org/*",
        "*://www.faune-grandest.org/*",
        "*://www.faune-guyane.fr/*",
        "*://www.faune-iledefrance.org/*",
        "*://www.faune-indre-et-loire.org/*",
        "*://www.faune-limousin.org/*",
        "*://www.faune-maine.org/*",
        "*://www.faune-nouvelle-aquitaine.org/*",
        "*://www.faune-occitanie.org/*",
        "*://www.faune-paca.org/*",
        "*://www.faune-paysdelaloire.org/*",
        "*://www.faune-reunion.fr/*",
        "*://www.faune-vendee.org/*",
        "*://www.faune-vienne.org/*",
        "*://www.ornitho.at/*",
        "*://www.ornitho.cat/*",
        "*://www.ornitho.ch/*",
        "*://www.ornitho.de/*",
        "*://www.ornitho.eus/*",
        "*://www.ornitho.it/*",
        "*://www.ornitho.lu/*",
        "*://www.ornitho.pl/*",
        "*://dabasdati.ornitho.lv/*",
        "*://data.biolovision.net/*"
      ],
      "css": [
        "css/biolovision-hide.css"
      ],
      "js": [
        "js/shared/core.js",
        "js/biolovision.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://ebird.org/*targets*"
      ],
      "js": [
        "js/shared/core.js",
        "js/eBird-target.js"
      ]
    },
    {
      "matches": [
        "*://ebird.org/*checklist/*"
      ],
      "js": [
        "js/shared/core.js",
        "js/eBird-checklist.js"
      ]
    },
    {
      "matches": [
        "*://macaulaylibrary.org/asset*",
        "*://www.macaulaylibrary.org/asset*"
      ],
      "js": [
        "js/shared/core.js",
        "js/macaulaylibrary.js"
      ]
    },
    {
      "matches": [
        "*://ebird.org/*tripreport/*"
      ],
      "js": [
        "js/shared/core.js",
        "js/eBird-tripreport.js"
      ]
    },
    {
      "matches": [
        "*://ebird.org/*mylocations/edit/*"
      ],
      "js": [
        "js/shared/core.js",
        "js/eBird-mylocation.js"
      ]
    },
    {
      "matches": [
        "*://ebird.org/*barchart*"
      ],
      "js": [
        "js/shared/core.js",
        "js/eBird-barchart.js"
      ]
    },
    {
      "matches": [
        "*://ebird.org/*region/*"
      ],
      "js": [
        "js/shared/core.js",
        "js/eBird-region.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "zoziologie-web-tools@raphaelnussbaumer.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
